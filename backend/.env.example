APP_ENVIRONMENT=development
APP_CORS_ORIGINS=["http://localhost:5173"]
KNOWLEDGE_INDEX_DIR=backend/data/index
KNOWLEDGE_DOCUMENTS_DIR=backend/data/documents
EMBEDDING_CACHE_DIR=backend/.cache/models
EMBEDDING_MODEL_ID=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
EMBEDDING_LOCAL_FILES_ONLY=false
KNOWLEDGE_ALLOWED_HOSTS=["cadreai.com"]
KNOWLEDGE_MAX_FILES=10
KNOWLEDGE_MAX_FILE_BYTES=5242880
KNOWLEDGE_MAX_UPLOAD_BYTES=20971520
KNOWLEDGE_MAX_REQUEST_BYTES=22020096
KNOWLEDGE_MAX_URLS=10
KNOWLEDGE_MAX_URL_BYTES=5242880
KNOWLEDGE_ADMIN_PASSWORD=replace-with-a-long-random-password
KNOWLEDGE_SESSION_SECRET=replace-with-an-independent-random-signing-secret
KNOWLEDGE_SESSION_TTL_SECONDS=1800
KNOWLEDGE_COOKIE_SECURE=false

# Generation settings are inactive until the provider phase.
CHAT_PROVIDER=openai
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_API_KEY=replace-with-a-local-secret
CHAT_MODEL=replace-with-an-approved-model
CHAT_TIMEOUT_SECONDS=20
CHAT_MAX_OUTPUT_TOKENS=400
