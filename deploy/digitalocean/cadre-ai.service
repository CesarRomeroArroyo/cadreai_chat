[Unit]
Description=Cadre AI Support API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cadreai
Group=cadreai
WorkingDirectory=/opt/cadre-ai/current/backend
EnvironmentFile=/etc/cadre-ai/backend.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HF_HOME=/var/lib/cadre-ai/models
ExecStart=/opt/cadre-ai/current/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cadre-ai

[Install]
WantedBy=multi-user.target
