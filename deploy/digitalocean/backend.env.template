APP_ENVIRONMENT=production
APP_CORS_ORIGINS=["https://__SERVER_NAME__"]
KNOWLEDGE_INDEX_DIR=/var/lib/cadre-ai/index
EMBEDDING_CACHE_DIR=/var/lib/cadre-ai/models
EMBEDDING_LOCAL_FILES_ONLY=true
EMBEDDING_CPU_THREADS=1
KNOWLEDGE_ALLOWED_HOSTS=["cadreai.com"]
KNOWLEDGE_MAX_REQUEST_BYTES=22020096
KNOWLEDGE_ADMIN_PASSWORD=replace-on-host-with-a-long-random-password
KNOWLEDGE_SESSION_SECRET=replace-on-host-with-an-independent-random-secret
KNOWLEDGE_COOKIE_SECURE=true

# Generation settings remain inactive until the provider phase.
CHAT_PROVIDER=openrouter
CHAT_BASE_URL=https://openrouter.ai/api/v1
CHAT_API_KEY=replace-on-host-before-chat-is-enabled
CHAT_MODEL=replace-with-approved-production-model
CHAT_TIMEOUT_SECONDS=20
CHAT_MAX_OUTPUT_TOKENS=400
CHAT_RETRIEVAL_TOP_K=6
CHAT_RETRIEVAL_MAX_PER_SOURCE=2
